# API Configuration
VITE_API_URL=http://localhost:8000
VITE_API_VERSION=v1

# Application Configuration
VITE_APP_TITLE=Family Calculator
VITE_APP_DESCRIPTION=Calculate family relationships based on shared DNA

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false
# Barra QA y selector de motor: true/false. Si no se setean, se muestran solo en local.
# VITE_SHOW_QA=true
# VITE_SHOW_ENGINE=true

# Development
VITE_DEV_SERVER_PORT=3000

# Production Settings
VITE_ENVIRONMENT=development  # development, staging, production 